clo_api_token       = "your-api-token-here"
clo_project_id      = "your-project-id"
default_image_id    = "your-image-id"        # используется только autotest-server
default_keypair_ids = ["your-ssh-key-id"]

# Опционально: образ ОС для остальных серверов (nginx, gitlab, gitlab-runner,
# kubernetes-*, postgres). Если не задать — используется значение по
# умолчанию из variables.tf (текущий образ, который уже используется в проде).
